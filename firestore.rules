rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /contactos/{contactoId} {
      // La app aún no tiene autenticación (Firebase Auth), así que estas
      // reglas no pueden exigir un usuario autenticado sin romper el CRUD.
      // Lo que sí evitan es el modo de prueba "allow read, write: if true"
      // sin fecha de expiración y datos con forma arbitraria.
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasAll(['nombre', 'telefono', 'ciudad'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() >= 7
        && request.resource.data.ciudad is string
        && request.resource.data.ciudad.size() >= 2;

      allow delete: if true;
    }
  }
}
